import QtQuick
import QtQuick.Layouts
import org.kde.plasma.plasma5support as P5Support

RowLayout {
    id: root

    // Standard properties injected by AOD host
    property real uiScale: 1.0
    property var extensionConfig: ({})
    property var aodConfig: ({})
    property bool aodVisible: true

    property string daemonMessage: "Waiting for daemon..."

    function dp(val) {
        return Math.round(val * (uiScale > 0 ? uiScale : 1.0));
    }

    spacing: dp(8)
    Layout.alignment: Qt.AlignHCenter

    // Periodic reading of the runtime file generated by the C++ daemon
    P5Support.DataSource {
        id: fileSource
        engine: "executable"
        connectedSources: []

        onNewData: (sourceName, data) => {
            const out = (data["stdout"] || "").trim();
            if (out.length > 0) {
                try {
                    const parsed = JSON.parse(out);
                    root.daemonMessage = parsed.message || "";
                } catch(e) {}
            }
            fileSource.disconnectSource(sourceName);
        }
    }

    Timer {
        interval: 2000
        repeat: true
        running: root.aodVisible
        onTriggered: {
            fileSource.connectSource("cat \"${XDG_RUNTIME_DIR:-/tmp}/aod-ext-example.json\" 2>/dev/null || cat /tmp/aod-ext-example.json 2>/dev/null");
        }
    }

    Text {
        text: (root.extensionConfig && root.extensionConfig.prefix ? root.extensionConfig.prefix : "") + " " + root.daemonMessage
        color: root.extensionConfig && root.extensionConfig.color ? root.extensionConfig.color : "#00ffcc"
        font.pixelSize: root.dp(14)
        font.bold: true
        renderType: Text.NativeRendering
    }
}
