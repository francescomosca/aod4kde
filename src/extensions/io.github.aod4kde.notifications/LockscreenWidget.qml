import QtQuick
import QtQuick.Layouts
import org.kde.kirigami as Kirigami
import org.kde.plasma.plasma5support as P5Support

RowLayout {
    id: root

    // Properties passed by AOD host AodClockStats
    property real uiScale: 1.0
    property var extensionConfig: ({})
    property var aodConfig: ({})
    property bool aodVisible: true

    function dp(val) {
        return Math.round(val * (uiScale > 0 ? uiScale : 1.0));
    }

    property var icons: []

    property real circleSize: dp(36)
    property real innerIconSize: dp(20)

    visible: icons && icons.length > 0
    opacity: visible ? 1 : 0
    spacing: dp(12)
    Layout.alignment: Qt.AlignHCenter
    Layout.topMargin: dp(4)
    Layout.bottomMargin: dp(4)

    Behavior on opacity {
        NumberAnimation { duration: Kirigami.Units.longDuration; easing.type: Easing.InOutQuad }
    }

    // DataSource to load notifications from the file generated by the daemon
    P5Support.DataSource {
        id: notifExecSource
        engine: "executable"
        connectedSources: []

        onNewData: (sourceName, data) => {
            const out = (data["stdout"] || "").trim();
            if (out.length > 0) {
                try {
                    const parsed = JSON.parse(out);
                    if (parsed && Array.isArray(parsed.icons)) {
                        root.icons = parsed.icons;
                    }
                } catch(e) {}
            } else {
                root.icons = [];
            }
            notifExecSource.disconnectSource(sourceName);
        }
    }

    function checkNotifications() {
        notifExecSource.connectSource("cat \"$XDG_RUNTIME_DIR/aod-notifications.json\" 2>/dev/null || cat ~/.cache/aod-notifications.json 2>/dev/null");
    }

    Timer {
        id: reloadTimer
        interval: 1500
        repeat: true
        running: root.aodVisible
        onTriggered: checkNotifications()
    }

    onAodVisibleChanged: {
        if (aodVisible) {
            checkNotifications();
        }
    }

    Component.onCompleted: checkNotifications()

    Repeater {
        model: root.icons

        Rectangle {
            width: root.circleSize
            height: root.circleSize
            radius: width / 2
            color: "transparent"
            border.color: "#4a4a4a"
            border.width: Math.max(1, root.dp(1))
            antialiasing: true
            Layout.alignment: Qt.AlignVCenter

            Kirigami.Icon {
                anchors.centerIn: parent
                width: root.innerIconSize
                height: root.innerIconSize
                Layout.preferredWidth: root.innerIconSize
                Layout.preferredHeight: root.innerIconSize
                source: modelData
                fallback: "preferences-desktop-notification-symbolic"
                isMask: true
                color: "#cccccc"
                opacity: 0.9
            }
        }
    }
}

