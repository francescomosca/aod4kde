#: src/settings/components/TabBehavior.qml:222
#, kde-format
msgid "Time & Energy Management:"
msgstr "Gestione Tempi & Risparmio Energetico:"

#: src/settings/components/TabBehavior.qml:230
#, kde-format
msgid ""
"<b>Important note on idle timeouts:</b><br/><br/>• <b>Screen locking:</b> "
"Determines after how many minutes of inactivity AOD activates.<br/>• "
"<b>Screen turn-off (DPMS):</b> Cuts power to the display.<br/>For AOD to "
"remain visible, this value must be <b>greater</b> than the screen lock "
"timeout (e.g. 15-30 min or Never)."
msgstr ""
"<b>Nota importante sui tempi di inattività:</b><br/><br/>• <b>Blocco dello "
"schermo:</b> Determina dopo quanti minuti di inattività si attiva l'AOD.<br/"
">• <b>Spegnimento dello schermo (DPMS):</b> Taglia l'alimentazione al "
"monitor.<br/>Perché l'AOD resti visibile, questo valore deve essere "
"<b>maggiore</b> rispetto al blocco schermo (es. 15-30 min o Mai)."

